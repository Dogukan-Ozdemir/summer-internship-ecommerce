@using MultiShop.DtoLayer.BasketDtos
@model BasketTotalDto

@{
    ViewData["Title"] = "Basket List";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    int count = 0;
}

<section class="content container-fluid">
    <div class="row">

        <div class="col-md-12">

            <div class="chart-box">

                <table class="table table-bordered">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>Image</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Total</th>
                            <th>Delete</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.BasketItems.Any())
                        {
                            foreach (var item in Model.BasketItems)
                            {
                                count++;

                                <tr>

                                    <td>@count</td>

                                    <td>@item.ProductName</td>

                                    <td>
                                        <img src="@item.ProductImageUrl"
                                             width="70" />
                                    </td>

                                    <td>@item.Price ₺</td>

                                    <td>@item.Quantity</td>

                                    <td>@(item.Price * item.Quantity) ₺</td>

                                    <td>
                                        <a href="/Admin/Basket/RemoveBasketItem?productId=@item.ProductId"
                                           class="btn btn-danger">
                                            Delete
                                        </a>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7" class="text-center">
                                    Basket is empty.
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

                <h4>Total : @Model?.TotalPrice ₺</h4>

                <br />

                <a href="/Admin/Basket/AddBasketItem"
                   class="btn btn-primary">

                    Add Basket Item

                </a>

                <a href="/Admin/Basket/DeleteBasket"
                   class="btn btn-danger">

                    Clear Basket

                </a>

            </div>

        </div>

    </div>
</section>
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <script>
        alert('@TempData["Success"]');
        window.location.href = '/Login/Logout';
    </script>
}

@model MultiShop.WebUI.Models.UserDetailViewModel


<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card shadow border-0">

                <div class="card-body text-center">

                    <img src="@ViewBag.ProfileImage"  
                         style="width:150px;
                    height:150px;
                    border-radius:50%;
                    object-fit:cover;
                    border:5px solid #FFD333;" />


                    <div class="mt-3">
                        <a asp-controller="Profile"
                           asp-action="SelectAvatar"
                           class="btn btn-primary">
                            Change Avatar
                        </a>
                    </div>

                    <h3 class="mt-4">@Model.Name</h3>

                    <p class="text-muted">@Model.Email</p>

                    <hr />

                    <div class="row text-left">

                        <div class="col-md-6 mb-3">
                            <label><b>First Name</b></label>
                            <input class="form-control" value="@Model.Name" readonly />
                        </div>

                       

                        <div class="col-md-6 mb-3">
                            <label><b>Username</b></label>
                            <input class="form-control" value="@Model.Username" readonly />
                        </div>

                        

                        <div class="col-md-6 mb-3">
                            <label><b>Email</b></label>
                            <input class="form-control" value="@Model.Email" readonly />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label><b>Account ID</b></label>
                            <input class="form-control" value="@Model.Id" readonly />
                        </div>

                    </div>

                    <a href="/User/Edit" class="btn btn-warning btn-lg mt-3">
                        <i class="fa fa-user-edit"></i>
                        Edit Profile
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>
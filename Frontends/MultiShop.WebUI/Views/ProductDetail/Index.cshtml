﻿@{
ViewData["Title"] = "Index";
Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container-fluid pb-5">
    <div class="row px-xl-5">

        @await Component.InvokeAsync("_ProductDetailImageSliderComponentPartial", new { id = ViewBag.x })

        @await Component.InvokeAsync("_ProductDetailFeatureComponentPartial", new { id = ViewBag.x })

    </div>
    <div class="row px-xl-5">
        <div class="col">
            <div class="bg-light p-30">
                <div class="nav nav-tabs mb-4">
                    <a class="nav-item nav-link text-dark active" data-toggle="tab" href="#tab-pane-1">product details</a>
                    <a class="nav-item nav-link text-dark" data-toggle="tab" href="#tab-pane-2">product info</a>
                    <a class="nav-item nav-link text-dark" data-toggle="tab" href="#tab-pane-3">comments</a>
                </div>
                <div class="tab-content">

                    @await Component.InvokeAsync("_ProductDetailDescriptionComponentPartial", new { id = ViewBag.x })

                    @await Component.InvokeAsync("_ProductDetailInformationComponentPartial", new { id = ViewBag.x })

                @*    @await Component.InvokeAsync("_ProductDetailReviewComponentPartial", new { id = ViewBag.x }) *@

                </div>
            </div>
        </div>
    </div>
    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const minus = document.querySelector(".btn-minus");
                const plus = document.querySelector(".btn-plus");
                const quantity = document.querySelector(".quantity input");

                minus.addEventListener("click", function () {
                    let value = parseInt(quantity.value);

                    if (value > 1)
                        quantity.value = value - 1;
                });

                plus.addEventListener("click", function () {
                    quantity.value = parseInt(quantity.value) + 1;
                });


                 

                $(".btn-plus").click(function () {
                var quantity = parseInt($("#quantity").val());

                quantity;

                $("#quantity").val(quantity);
            });


            $(".btn-minus").click(function () {

                var quantity = parseInt($("#quantity").val());

                if(quantity > 1)
                {
                    quantity;

                    $("#quantity").val(quantity);
                }

            });


            $("form").submit(function () {
                $("#quantityInput").val($("#quantity").val());
            });

  

            });
    </script>
</div>




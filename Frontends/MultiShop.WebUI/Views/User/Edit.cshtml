@model MultiShop.WebUI.Models.UserDetailViewModel

@{
    ViewData["Title"] = "Edit Profile";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<div class="container py-5">

    <div class="card shadow p-4">

        <h3 class="mb-4">
            Edit Profile
        </h3>


        <form asp-action="Edit" method="post">


            <div class="mb-3">
                <label class="form-label">
                    User ID
                </label>

                <input asp-for="Id"
                       class="form-control"
                       readonly />
            </div>


            <div class="mb-3">
                <label class="form-label">
                    Username
                </label>

                <input asp-for="Username"
                       class="form-control" />
            </div>


            <div class="mb-3">
                <label class="form-label">
                    Email
                </label>

                <input asp-for="Email"
                       class="form-control" />
            </div>


            <div class="mb-3">
                <label class="form-label">
                    Name
                </label>

                <input asp-for="Name"
                       class="form-control" />
            </div>


            <button type="submit" class="btn btn-primary">
                Save Changes
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>
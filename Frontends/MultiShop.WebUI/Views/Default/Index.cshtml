@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}
@*

<div class="container-fluid">
    <div class="row px-xl-5">
        <div class="col-12">
            <nav class="breadcrumb bg-light mb-30">
                <a class="breadcrumb-item text-dark" href="#">Home</a>
                <span class="breadcrumb-item active">Contact</span>
            </nav>
        </div>
    </div>
</div>

<div class="container-fluid">
    <h2 class="section-title position-relative text-uppercase mx-xl-5 mb-4"><span class="bg-secondary pr-3">Contact Us</span></h2>
    <div class="row px-xl-5">
        <div class="col-lg-7 mb-5">
            <div class="bg-light p-30">
                <h4 class="mb-4">Receive messages instantly with our PHP and Ajax contact form - available in the <a href="https://htmlcodex.com/downloading/?item=1479">Pro Version</a> only.</h4>
                <form>
                    <div class="control-group mb-3">
                        <input type="text" class="form-control" placeholder="Your Name" />
                    </div>
                    <div class="control-group mb-3">
                        <input type="email" class="form-control" placeholder="Your Email" />
                    </div>
                    <div class="control-group mb-3">
                        <input type="text" class="form-control" placeholder="Subject" />
                    </div>
                    <div class="control-group mb-3">
                        <textarea class="form-control" rows="8" placeholder="Message"></textarea>
                    </div>
                    <div>
                        <button class="btn btn-primary py-2 px-4" type="submit">
                            Send
                            Message
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <div class="col-lg-5 mb-5">
            <div class="bg-light p-30 mb-30">
                <iframe style="width: 100%; height: 315px;"
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3123.254116494293!2d27.12855357616912!3d38.41887017182288!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x14bbd8b64c5d8b6b%3A0x41f6d7d73b4d7b5f!2sKonak%20Square!5e0!3m2!1sen!2str!4v1720000000000!5m2!1sen!2str"
                        frameborder="0" style="border:0;" allowfullscreen="" aria-hidden="false" tabindex="0"></iframe>
            </div>
            <div class="bg-light p-30 mb-3">
                <p class="mb-2"><i class="fa fa-map-marker-alt text-primary mr-3"></i>Konak Square (Konak Meydanı),İzmir,TURKEY</p>
                <p class="mb-2"><i class="fa fa-envelope text-primary mr-3"></i>DoDoTicaret123@gmail.com</p>
                <p class="mb-2"><i class="fa fa-phone-alt text-primary mr-3"></i>+0543 321 12 14</p>
            </div>
        </div>
    </div>
</div>
*@

@await Component.InvokeAsync("_CarouselDefaultComponentPartial")
@await Component.InvokeAsync("_FeatureDefaultComponentPartial")
@await Component.InvokeAsync("_CategoriesDefaultComponentPartial")
@await Component.InvokeAsync("_FeatureProductsDefaultComponentPartial")
@await Component.InvokeAsync("_OfferDiscountDefaultComponentPartial")

@await Component.InvokeAsync("_VendorDefaultComponentPartial")